# Copy this file to .env and replace the example values with the current
# Terraform outputs from infrastructure/environments/dev.
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_example
COGNITO_USER_POOL_CLIENT_ID=exampleclientid
COGNITO_ISSUER_URI=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_example

# The frontend and backend use the same Cognito User Pool and app client.
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_example
VITE_COGNITO_USER_POOL_CLIENT_ID=exampleclientid
